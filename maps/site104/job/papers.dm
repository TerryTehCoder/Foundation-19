/obj/item/paper/dclass_orientation
	name = "Class-D Orientation Letter"
	info = "<small>Greetings,<br><br>On behalf of all staff within The Foundation, we welcome you to Site-53. You have chosen, or been chosen for the honor of joining the Foundation Rehabilitation Program. During your thirty day stay within this facility, you will be known as Class-D personnel, and be given a unique numerical designation for ease of access, which has been printed on your new ID card. <br><br>Over the course of your stay here, you will undergo various programs to ensure that you are ready to re-enter the world again. You will be given the opportunity to select a job within your block, in order to assist your fellow D-Class. From working the kitchen, to digging out objects within our mining area. On top of this, you may be selected for various medical or research tests to assist in our projects. What are those projects? Unfortunately, we can't tell you that.<br><br>Given that you are cooperative with our staff for the entirety of your stay here, you will be released back into the world, and have your criminal record erased completely. With that being said, we hope that you enjoy your stay here.<br><br>Sincerely,<br>The Administrator</small>"
	desc = "A laminated piece of paper given to D-Class personnel upon their arrival."

/obj/item/paper/engineering_workorder
	name = "Engineering Work Order Notice"
	info = "<center><large><b>ENGINEERING WORK ORDER NOTICE</b></large></center><br> <center><b>Site-104</b></center><br> <center></center><br> <center><i>Secure. Contain. Protect.</i></center><br> <hr> <center><b>WORK ORDER PROCEDURES</b></center><br> <u><b>ALL MAINTENANCE, REPAIRS, AND MODIFICATIONS REQUIRE PRIOR APPROVAL.</b></u><br> - Work orders must be submitted via the <i>Site-104 Engineering Database</i>.<br> - <i>Emergency repairs</i> may bypass standard approval but must be reported to <i>Site Administration</i> upon completion.<br> - Any structural modifications to containment areas require joint approval from <i>Engineering, Security, and Research Divisions</i>.<br> - Unauthorized alterations to <i>power grids, ventilation, or containment systems</i> are considered a direct breach of Foundation protocol.<br><br> <u><b>WORK REQUEST SUBMISSION:</b></u><br> 1. Fill out Form <i>E-104</i> detailing location, issue, and urgency.<br> 2. Submit form to <i>Site Engineering Supervisor</i> for review.<br> 3. Await approval and assignment of designated repair team.<br> 4. Upon completion, submit a <i>post-maintenance report</i> to the Engineering Database.<br><br> <center><b>PRIORITY LEVELS & RESPONSE TIMES</b></center><br> <u><b>Priority 1 (Critical):</b></u> <i>Immediate action required.</i><br> - Failure will result in site-wide containment breach, power failure, or loss of life.<br> - Response Time: <i>Within 5 minutes.</i><br> - Example: Reactor breach, major structural collapse, mass containment failure.<br><br> <u><b>Priority 2 (High):</b></u> <i>Significant impact on site operations.</i><br> - Does not pose immediate lethal risk but could escalate if left unattended.<br> - Response Time: <i>Within 30 minutes.</i><br> - Example: Power fluctuations, failing ventilation, non-critical SCP containment faults.<br><br> <u><b>Priority 3 (Routine):</b></u> <i>Scheduled maintenance and repairs.</i><br> - Does not interfere with core functions but must be addressed to prevent future issues.<br> - Response Time: <i>24-48 hours.</i><br> - Example: Wear-and-tear repairs, standard infrastructure upkeep, minor electrical faults.<br><br> <center><b>SAFETY PROTOCOLS & REGULATIONS</b></center><br> <i>ALL PERSONNEL MUST COMPLY WITH ENGINEERING SAFETY STANDARDS.</i><br> - PPE (<i>Personal Protective Equipment</i>) <i>must</i> be worn in all active work zones.<br> - Any maintenance within <i>containment zones</i> must be conducted under armed security supervision.<br> - <i>Failure to report damaged or faulty infrastructure</i> is a direct violation of site policy.<br> - Electrical and mechanical repairs <i>must</i> be logged in the site’s <i>engineering archive</i>.<br><br> <u><b>HAZARDOUS MATERIAL HANDLING:</b></u><br> - Any exposure to <i>coolants, plasma leaks, or high-voltage systems</i> requires medical evaluation.<br> - <i>R-UST Reactor personnel</i> must be radiation-screened <i>before and after shifts</i>.<br> - Disposal of hazardous waste must follow <i>Containment Waste Protocol C-17</i>.<br><br> <center><b>FAILURE TO COMPLY WILL RESULT IN DISCIPLINARY ACTION.</b></center><br> <hr>"
	desc = "A work order notice from the engineering department describing safety procedures and levels."

/obj/item/paper/weatherlog
	name = "Aged Weather Log"
	info = "<center><large><b>SITE-104 WEATHER LOG</b></large></center><br> <center><b>Annex Deck Severe Weather Shelter</b></center><br> <center></center><br> <center><i>Secure. Contain. Protect.</i></center><br> <hr> <center><b>WEATHER EVENT RECORD — PAPER LOG COPY</b></center><br> <u><b>DOCUMENT NO.:</b></u> WX-104-N/231-A<br> <u><b>DATE:</b></u> ██/██/198█<br> <u><b>SHIFT LEAD:</b></u> H. Ellwood<br> <u><b>LOCATION:</b></u> North Deck Storm Shelter<br><br> <center><b>EVENT LOG</b></center><br> <u><b>22:34 hours:</b></u><br> Barometric pressure falling. Wind speed steady at 37 kts. Light precipitation observed. Radio check with Marine Control satisfactory. Bulkhead status: <b>GREEN</b>.<br><br> <u><b>23:11 hours:</b></u><br> Wind gusts increased to 53 kts. Rain heavy. Lightning activity approaching from WNW. Personnel advised to secure loose deck equipment. Bulkhead status: <b>GREEN</b>.<br><br> <u><b>00:46 hours:</b></u><br> Lightning strike confirmed on the Weather Deck Crane Assembly. Power fluctuations recorded. Emergency lighting operational. Bulkhead status: <b>YELLOW</b>.<br><br> <u><b>01:22 hours:</b></u><br> Sky conditions anomalous — dense black cloud cover, no lightning observed for 20 minutes. Wind speed readings inconsistent (42 kts / 73 kts oscillating). Marine Control reporting instrument errors. Audible hum reported across Deck 3. Bulkhead status: <b>YELLOW</b>.<br><br> <u><b>01:55 hours:</b></u><br> Communication lost with Deck 1. Last transmission incomplete, relayed as:<br> <i>“—you seeing this? It's movi—”</i><br> No visual confirmation. Bulkhead status: <b>ORANGE</b>.<br><br> <u><b>02:38 hours:</b></u><br> Multiple personnel report unverified movement in fog banks offrig. Visual range reduced to 15 meters. Marine Control nonresponsive. Secondary storm warning issued by Surface Control. </br>Bulkhead status: <b>ORANGE</b>.<br><br> <u><b>03:17 hours:</b></u><br> Sky turned black. Total loss of external visibility. Anomalous interference detected on emergency radios. Bulkheads closed and secured. All remaining personnel accounted for inside Blackout Shelter B. Heavy percussion noises reported on Upper Deck structure. Bulkhead status: <b>RED</b>.<br><br> <u><b>03:52 hours:</b></u><br> Wind speed instruments nonfunctional. Last recorded reading: 132 kts. Severe structure vibration. No external contact possible. Storm log continues on paper copy. Backup generator active.<br><br> <center><b>NOTES</b></center><br> — Atmospheric behavior inconsistent with standard Category 4 storm patterns.<br> — Marine Control nonresponsive. Possible communications line failure.<br> — All personnel instructed to remain in shelter until clearance granted by Command.<br><br> <u><b>SIGNED:</b></u> H. Ellwood<br> <i>Original Signature Attached</i><br> <hr>"
	desc = "A weather log detailing a severe storm event. The log is heavily damaged and the ink is smudged in places. The last entry is incomplete, and the log ends abruptly."

/obj/item/paper/decomhelipadnotice
	name = "Decommisioned Helipad Notice"
	info = "<center><large><b>NOTICE OF FACILITY DECOMMISSIONING</b></large></center><br> <center><b>Site-104 – Research/Admin Junction Helipad (LZ-1)</b></center><br> <center><i>Secure. Contain. Protect.</i></center><br> <hr> <center><b>NOTICE TO ALL PERSONNEL</b></center><br> <u><b>THE RAJ HELIPAD (RESEARCH/ADMIN JOINT ACCESS) IS HEREBY DESIGNATED AS INACTIVE.</b></u><br> Effective immediately, the RAJ Helipad is no longer considered an operational landing zone for manned or unmanned aerial vehicles.<br><br> <u><b>REASON FOR DECOMMISSIONING:</b></u><br> - Structural fatigue and prolonged exposure to coastal weather systems.<br> - Inconsistent maintenance compliance and repeated misuse by unauthorized departments.<br> - Proximity interference with Site Logistics airspace and ongoing research field deployments.<br><br> <u><b>RESTRICTED USE CLAUSE:</b></u><br> - <i>No landing operations</i> are to be conducted without written approval from Site Administration.<br> - Platform is to remain <i>clear of all active staging, refueling, or drone relay systems</i>.<br> - Unauthorized use of this helipad may result in <i>equipment seizure and disciplinary review</i>.<br><br> <u><b>RECLAMATION & CLEARANCE PROCEDURES:</b></u><br> - Departments with existing assets on-site (e.g. scientific samples, sensor nodes, uplink cables) must remove all equipment within <b><s>7 days</s></b>, <b><s>14 days</s></b>, <b><s>30 days</s></b>, <b>indefinitely, pending further review</b>.<br> - Unclaimed objects will be tagged and relocated to the <i>Weatherdeck Overflow Storage (Deck-2, Unit-A2)</i>.<br> - The moss testing patch is to be transferred to the Biology Rooftop Zone under BS-2 conditions.<br><br> <u><b>SIGNAGE & ENFORCEMENT:</b></u><br> - Official DECOMMISSIONED placards will be posted at all pad entry points.<br> - Barrier fencing and caution tape will be installed by Engineering Staff.<br> - RAJ pad will be reevaluated for potential conversion into a non-flight operations staging area in Q4.<br><br> <center><b>THIS IS NOT AN ACTIVE LANDING ZONE.</b></center><br> <center><i>Violators may be subject to immediate security intervention.</i></center><br> <hr> <center><b>DOCUMENT NO. RAJ-LZ01/DECOM-024</b></center><br> <center><i>Authorized by: Site Engineering & Logistics Coordination Committee</i></center><br>"
	desc = "A notice detailing the decommissioning of the helipad on the Research/Admin Junction. The notice is heavily damaged and the ink is smudged in places."

/obj/item/paper/relaynode
	name = "Relay Node Directory"
	info = "<center><large><b>RELAY NODE-Δ2 — INTERCOM DIRECTORY</b></large></center><br> <center><b>Site-104</b></center><br> <center><i>Property of Foundation Telecommunications Division</i></center><br> <hr> <u><b>INTERCOM FUNCTIONAL DIRECTORY:</b></u><br> <b>[CH 01]</b> — <i>Research – Controlled Storage</i><br> - <u>Status:</u> Partial static. Audio feed functional.<br> - <u>Note:</u> Do not acknowledge unidentified tapping patterns.<br><br> <b>[CH 02]</b> — <i>Administration – Internal Office PA (A1)</i><br> - <u>Status:</u> Listen-only.<br> - <u>Note:</u> Used for emergency access codes and lockdown alerts. <i>Not to be tampered with.</i><br><br> <b>[CH 03]</b> — <i>Logistics Hangar – Main Load Bay (L2)</i><br> - <u>Status:</u> Active with delay.<br> - <u>Note:</u> Do not use during rotor load-ins. Volume may spike unexpectedly.<br><br> <b>[CH 04]</b> — <i>Marine Control Communications Center – Emergency Override Port (C1)</i><br> - <u>Status:</u> Emergency use only.<br> - <u>Note:</u> Backup line for grid failure. Susceptible to uplink drift.<br><br> <b>[CH 05]</b> — <i>Maintenance Shaft D1F – Utility Crawl (D1-Underside)</i><br> - <u>Status:</u> Signal integrity compromised.<br> - <u>Note:</u> Unknown source interference. Disconnect if unregistered sounds persist beyond 90 seconds.<br><br> <b>[CH 06]</b> — <i>Marine Control – Sea Approach Watch Deck (M1)</i><br> - <u>Status:</u> Weather-dependent. Signal clarity varies.<br> - <u>Note:</u> Hold tone if no response within 10 seconds. No informal chatter.<br><br> <hr> <center><i>Emergency intercom access must be logged in the Site Engineering Archive within 24 hours of use.</i></center><br> <center><b>Unauthorized use will result in an Incident Report with risk of demotion.</b></center><br>"
	desc = "A directory of the intercom channels within the relay node. The paper is slightly wet, and the ink is smudged in places with what appears to be.. beans?"

